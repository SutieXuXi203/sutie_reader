# ==============================================================================
# Database Configuration
# ==============================================================================
# MongoDB Connection String (Atlas SRV or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sutie_archive?retryWrites=true&w=majority

# ==============================================================================
# Root Administrator Credentials (For initial seed & admin protection)
# ==============================================================================
ADMIN_USERNAME=admin@domain.com
ADMIN_PASSWORD=your_secure_admin_password

# Optional Test Account (for security tests)
TEST_USERNAME=test@domain.com
TEST_PASSWORD=your_secure_test_password

# ==============================================================================
# Application URL & SEO
# ==============================================================================
# Base URL of the deployment (used for Open Graph images, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Authentication & Security
# ==============================================================================
# Secret key used to sign and verify JWT authentication tokens (min 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_hex

# Site-wide 6-digit PIN Lock Screen (optional, leave empty to disable)
UNLOCK_PIN=123456

# ==============================================================================
# Email Configuration (Nodemailer SMTP for OTP verification)
# ==============================================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ==============================================================================
# Google Drive Integration (for comic chapter images storage)
# ==============================================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_parent_folder_id

# ==============================================================================
# Cloudflare Worker & Anti-Leech Image Security
# ==============================================================================
# Cloudflare Worker deployment endpoint serving comic images
CLOUDFLARE_WORKER_URL=https://your-worker-subdomain.workers.dev
NEXT_PUBLIC_CLOUDFLARE_WORKER_URL=https://your-worker-subdomain.workers.dev

# Shared secret between Next.js backend and Cloudflare Worker for uploads
CLOUDFLARE_UPLOAD_SECRET=your_secret_upload_passphrase

# Cloudflare API Token for Worker cache purging / deployments
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Image URL Signing secret (HMAC token verification)
IMAGE_SIGNING_SECRET=your_image_signing_hmac_secret_key
IMAGE_SIGNED_URL_TTL_SECONDS=120
IMAGE_RATE_LIMIT_MAX=360
IMAGE_RATE_LIMIT_WINDOW_MS=60000

# ==============================================================================
# Telegram Bot Alerts & Error Logging
# ==============================================================================
# Bot token from @BotFather and your Target Chat ID
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=1234567890
